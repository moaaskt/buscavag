# ==============================================================================
# Dockerfile.web - Frontend Dashboard (Next.js)
# ==============================================================================
# Multi-stage build para imagem de produção otimizada.

# --- Stage 1: Instalar dependências ---
FROM node:22-alpine AS deps
WORKDIR /app

# Instala dependências de build para pacotes nativos (better-sqlite3)
RUN apk add --no-cache python3 make g++

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

# --- Stage 2: Build da aplicação Next.js ---
FROM node:22-alpine AS builder
WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# Definir caminho do banco (será montado via volume)
ENV DATABASE_PATH=/app/data/buscavag.db

RUN npm run build:next

# --- Stage 3: Imagem de produção ---
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV DATABASE_PATH=/app/data/buscavag.db

# Criar diretório de dados para o volume
RUN mkdir -p /app/data

# Copiar o standalone output (já inclui server.js e node_modules internos)
COPY --from=builder /app/.next/standalone ./
# Copiar static assets e public (não incluídos no standalone)
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000

ENV HOSTNAME="0.0.0.0"
ENV PORT=3000

CMD ["node", "server.js"]

# Configurações do Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Configurações do Hermes Agent / LLM (Opcional - Deixe vazio para usar a Heurística)
GEMINI_API_KEY=
HERMES_MODEL=gemini-flash-latest

# Banco de Dados
DATABASE_PATH=./buscavag.db

# Configurações do WhatsApp Notifier (Evolution API ou Webhook Genérico)
WHATSAPP_PROVIDER=mock # 'evolution' | 'webhook' | 'mock'
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=buscavag
WHATSAPP_DEFAULT_RECIPIENT=
WHATSAPP_MIN_SCORE=80
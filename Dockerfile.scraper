# ==============================================================================
# Dockerfile.scraper - Backend Scrapers + Cron (Node.js + Playwright)
# ==============================================================================
# Usa base Debian (jammy) para suportar as dependências de browser do Playwright.

FROM node:22-bookworm-slim AS base
WORKDIR /app

# Instalar dependências de sistema necessárias para Playwright Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libx11-xcb1 \
    libxcb1 \
    libxext6 \
    libx11-6 \
    libatspi2.0-0 \
    fonts-liberation \
    fonts-noto-color-emoji \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copiar package.json e instalar dependências do Node
COPY package.json package-lock.json* ./
RUN npm ci

# Instalar navegadores do Playwright (apenas Chromium para economia de espaço)
RUN npx playwright install chromium

# Copiar código-fonte
COPY . .

# Definir caminho do banco (será montado via volume)
ENV DATABASE_PATH=/app/data/buscavag.db
ENV NODE_ENV=production

# Criar diretório de dados para o volume
RUN mkdir -p /app/data

# O processo roda infinitamente via node-cron
CMD ["npm", "run", "start:cron"]
